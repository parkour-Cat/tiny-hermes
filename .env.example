ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://tiny_hermes:local-only@localhost:5432/tiny_hermes
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tiny-hermes
# Object-store credentials, required since phase 3C: SessionWorkspace revisions
# and Artifacts are real MinIO objects. The compose defaults below match the
# bundled MinIO service and are for an isolated local machine only.
S3_ACCESS_KEY=tiny-hermes-local
S3_SECRET_KEY=tiny-hermes-local-password
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters

# The Compose defaults are only for an isolated local machine. Production deployments must
# generate random secrets and mount the KEK from a protected file or KMS rather than
# leaving TINY_HERMES_KEK in the process environment.

# Outbound calls. Every model request and endpoint check goes through
# SafeOutboundClient, which refuses loopback, link-local, the cloud metadata
# addresses, carrier-grade NAT and private ranges. OUTBOUND_ALLOWED_CIDRS opens
# specific private ranges — and only private ones, so approving a wide range
# never opens this host to itself.
# OUTBOUND_ALLOWED_CIDRS=10.20.0.0/16
# OUTBOUND_READ_TIMEOUT_SECONDS=60
# MODEL_MAX_ATTEMPTS=3

# A model endpoint's credential_ref is either an environment-variable name
# (overlap with 3A) or the UUID of an active Secret. The env form still works.
# TINY_HERMES_MODEL_KEY_EXAMPLE=set-this-to-your-own-endpoint-key

# Envelope KEK: 32 bytes as standard base64. Required for API /health/ready.
# The Compose default is 32 zero bytes and is for an isolated local machine only.
# Worker processes boot without it; unwrap at call time fails that call.
# TINY_HERMES_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# TINY_HERMES_KEK_ID=v1
# TINY_HERMES_PREVIOUS_KEK=
# TINY_HERMES_PREVIOUS_KEK_ID=

# The outbound boundary (product design §16.5). Unset, every outbound call
# refuses rather than connecting directly — that is the intended default and
# not a misconfiguration, but it also means no model endpoint, no skill import,
# no HTTP tool and no MCP server works until these are set.
#
# EGRESS_PROXY_URL is where trusted processes send their traffic; in Compose
# that is the service name. EGRESS_PROXY_TOKEN is what they present so the
# proxy can tell one of ours from a sandbox — it decides *who is asking*, never
# what they may reach, so a leaked token widens nothing by itself.
# EGRESS_ALLOWED_HOSTS is the platform layer for a single-tenant installation
# that keeps no scope rows; workspaces and Agents narrow it and never widen it.
# EGRESS_PROXY_URL=http://egress-proxy:3128
# EGRESS_PROXY_TOKEN=
# EGRESS_ALLOWED_HOSTS=api.openai.com,*.example.com
#
# Which ports a target may listen on. Unset means the web's two, 80 and 443. A
# scope entry cannot name a port, so without this an approved host doubles as
# an approved SSH or database server — and widening it is therefore a platform
# administrator's decision and only theirs. An enterprise's own API on 8443 is
# the ordinary reason to.
# EGRESS_ALLOWED_PORTS=80,443,8443

# Which Docker network a sandbox is attached to. Empty means a sandbox has no
# network at all, which is M1's behaviour and still the right default. Set to
# the Compose network for the internal bridge, and the proxy becomes the one
# thing a container can send a packet to.
# SANDBOX_EGRESS_NETWORK=tiny-hermes_sandbox-egress

# The sandbox. SANDBOX_IMAGE_DIGEST is the one image the Sandbox Controller will
# run, by digest — an empty allowlist approves nothing, so a deployment that has
# not chosen an image cannot run a tool at all. Build it and read the digest:
#   docker build -t tiny-hermes-sandbox:local -f deploy/sandbox/Dockerfile deploy/sandbox
#   docker image inspect tiny-hermes-sandbox:local --format '{{.Id}}'
# SANDBOX_IMAGE_DIGEST=sha256:...
# SANDBOX_IDLE_TTL_SECONDS=300
